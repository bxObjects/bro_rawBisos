createBannersSpecific_BYNAME_TRIAL () {

    updateSurroundings () {
	opDo bystarPloneFeature.sh -h -v -n showRun -p bystarUid=${bystarUid} -i footer_add
	opDo bystarPloneFeature.sh -h -v -n showRun -p bystarUid=${bystarUid} -i colophon_add
	opDo bystarPloneFeature.sh -h -v -n showRun -p bystarUid=${bystarUid} -p style=horizontal -i topright_add
        opDo bystarPloneFeature.sh -h -v -n showRun -p bystarUid=${bystarUid} -i cssTemplate_update
    }
    

    bannerGenLatex () {
      opDoExit cat <<  _EOF_

\documentclass[11pt]{article}
\usepackage[usenames,dvipsnames]{color}
\usepackage{arabtex}

\setlength{\textwidth}{9cm}
\setlength{\topmargin}{-2cm}
\setlength{\textheight}{5cm}
\setlength{\oddsidemargin}{0.0cm}
\setlength{\evensidemargin}{0.0cm}

\parindent 0mm

