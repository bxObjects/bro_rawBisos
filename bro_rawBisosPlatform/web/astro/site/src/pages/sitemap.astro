---
// The site map: the navigation (tabs and their left trees), fully open; Home first.
import Base from "../layouts/Base.astro"
import { menu } from "../lib/menu.mjs"

function flatten(items, depth = 0) {
  return items.flatMap((i) => [{ ...i, depth }, ...(i.children ? flatten(i.children, depth + 1) : [])])
}
---
<Base title="Site Map">
  <h1>Site Map</h1>
  <ul class="sitemap">
    {flatten(menu).map((i) => (
      <li style={`margin-inline-start: ${i.depth * 1.5}rem`}><a href={i.path}>{i.label}</a></li>
    ))}
  </ul>
</Base>
