#!/usr/bin/env python

""" #+begin_org
* ~[Summary]~ :: A =PlantedCmndService= for platform.here NGINX virtual-host (capWebVd) --- serves the built site
#+end_org """

from bisos.b import cs
import collections

from bisos.csSeed import seedsLib

from bisos.webCap import capWebVd_seed  # noqa: F401  # _atExit_

from bisos.webCap import capWebVd_seedInfo

serverName = "platform.here"
# Static files from gatsby build (cbm/platform-assemble.cs -i gatsbyBuild); no program behind it.
# By the platform's stable name, so it does not depend on where bro_rawBisos is cloned.
rootBaseDir = "/bisos/platform/web/gatsby/site/public"

def wvdConfigFunc() -> str:
    """webVd_nginxSites.atBaseSite, plus Gatsby's own 404 page."""
    return f"""\
server {{
    listen 80;
    server_name {serverName};

    root {rootBaseDir};
    index index.html;

    location / {{
        try_files $uri $uri/ =404;
    }}

    error_page 404 /404.html;
}}
"""

capWebVd_seedInfo.setup(
    serverName=serverName,
    proxyPort="NA",
    wvdConfigFunc=wvdConfigFunc,
)

from bisos.csSeed import csCmndsList_seedInfo
csCmnd = csCmndsList_seedInfo.csCmnd

csCmndsList = [
    csCmnd("configFileStdout", pars={'cls': 'configFile_nginxVd'},),
    csCmnd("configFileUpdate", pars={'cls': 'configFile_nginxVd', 'runAs': 'root'},),
    csCmnd("webVd_enable",),
    csCmnd("webVd_verify",),
    csCmnd("webVd_resolve",),
    csCmnd("webVd_fqdnPing",),
]

csCmndsList_seedInfo.setup(
    csCmndsList=csCmndsList,
)
