#!/usr/bin/env python

""" #+begin_org
* cbmProc.spcs --- airflow as a webHere-collective capability
*
* Planted location: sys/cbm/collective/webHere/airflow/cbmProc.spcs
* Realm:            collective
* CapabilityType:   webHere    (HTTP via .here fake domain)
* CapabilityName:   airflow    (accessible as airflow.here)
*
* CBM sits on top of CBS --- it does NOT duplicate CBS content.
* This file is a *pointer* to the CBS executable. cbm_* verbs
* subprocess-invoke that executable at dispatch time.
*
* cbsSpec resolution:
*   - "/some/path" or path with '/'  -> use as-is (absolute lock)
*   - bare basename                  -> shutil.which() against PATH
#+end_org """

# --- atexit hook: register cbmProc-seed.cs as this file's seed ---
from bisos.capability import cbmProc_seed  # noqa: F401  _atExit_

# --- declare which capability this leaf represents + point to CBS ---
from bisos.capability import cbmProc_seedInfo
cbmProc_seedInfo.setup(
    capabilityName="airflow",
    cbsSpec="/bisos/asc/web/bin/airflow-cbs.pcs",   # basename form (requires /bisos/asc/web/bin on PATH)
    # cbsSpec="/bisos/asc/web/bin/airflow-cbs.pcs",  # absolute-lock alternative
)
