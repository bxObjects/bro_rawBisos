#!/usr/bin/env python

""" #+begin_org
* cbmBootstrap-sbom.pcs --- what the astroStarter capability needs before its CBS can run
*
* Run by cbmProc.spcs: -i cbm_bootstrap, and first by cbm_materialize, cbm_reMaterialize and
* cbm_sbom (bisos.capability). By hand: ./cbmBootstrap-sbom.pcs -i sbom_fullUpdate
*
* The CBS is in the bisos-web/astro-starter-bystar repo (cloned centrally); it is seeded by
* bisos.capability, and its assemble uses bisos.webCap.
*
* Phase 1 (bxGenesis/base 3.1.2): pip packages only, into the bisos3 venv. The git clones are
* the platform's (bisos.common's clone registry). Phase 2 adds the leaf's clones here.
#+end_org """

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")
pp = pkgsSeed.pipPkg

pipPkgsList = [
    pp("bisos.webCap"),
]

pkgsSeed.setup(
    pipPkgsList=pipPkgsList,
    virtenv="/bisos/venv/py3/bisos3",
)
