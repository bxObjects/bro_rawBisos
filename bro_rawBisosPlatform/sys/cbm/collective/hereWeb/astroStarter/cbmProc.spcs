#!/usr/bin/env python

""" #+begin_org
* cbmProc.spcs --- astroStarter as a hereWeb-collective capability
*
* Planted location: sys/cbm/collective/hereWeb/astroStarter/cbmProc.spcs
* Realm:            collective
* CapabilityType:   hereWeb    (HTTP via .internal fake domain)
* CapabilityName:   astroStarter (astro-starter-bystar as astroStarter.internal)
*
* CBM sits on top of CBS --- it does NOT duplicate CBS content.
* This file is a *pointer* to the CBS executable. cbm_* verbs
* subprocess-invoke that executable at dispatch time.
*
* cbsSpec resolution:
*   - "/some/path" or path with '/'  -> use as-is (absolute lock)
*   - bare basename                  -> shutil.which() against PATH
#+end_org """

# --- atexit hook: register cbmProc-seed.cs as this file's seed ---
from bisos.capability import cbmProc_seed  # noqa: F401  _atExit_

# --- declare which capability this leaf represents + point to CBS ---
from bisos.capability import cbmProc_seedInfo

cbmProc_seedInfo.setup(
    capabilityName="astroStarter",
    cbsSpec="/bisos/git/bxRepos/bisos-web/astro-starter-bystar/cbm/astroStarter-cbs.pcs",
    verifySpec="cd /bisos/git/bxRepos/bisos-web/astro-starter-bystar && ./astroProc.spcs -i siteVerify",
)
